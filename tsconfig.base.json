{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@huyasi/shared-web-client-base-ui-components": [
        "libs/shared/web-client/base/ui-components/src/index.ts"
      ],
      "@huyasi/shared-web-client-base-ui-design": [
        "libs/shared/web-client/base/ui-design/src/index.ts"
      ],
      "@huyasi/core-auth-bff-session": ["libs/core/auth-bff/session/src/index.ts"],
      "@huyasi/core-auth-bff-openid-connect": ["libs/core/auth-bff/openid-connect/src/index.ts"],
      "@huyasi/core-auth-bff-app-type": ["libs/core/auth-bff/app-type/src/index.ts"],
      "@huyasi/shared-web-client-auth-feature": [
        "libs/shared/web-client/auth/feature/src/index.ts"
      ],
      "@huyasi/shared-web-client-auth-ui-components": [
        "libs/shared/web-client/auth/ui-components/src/index.ts"
      ],
      "@huyasi/shared-web-client-auth-utils": ["libs/shared/web-client/auth/utils/src/index.ts"],
      "@huyasi/public-web-client-auth-ui-components": [
        "libs/public/web-client/auth/ui-components/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
